 "components": {
  "schemas": {
   "AlertCreate": {
    "properties": {
     "alert_ticket": {
      "type": "string",
      "maxLength": 4000,
      "title": "Alert Ticket"
     },
     "contact_ids": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 5,
      "minItems": 1,
      "title": "Contact Ids"
     },
     "note": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 280
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     },
     "include_excerpt": {
      "type": "boolean",
      "title": "Include Excerpt",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "alert_ticket",
     "contact_ids"
    ],
    "title": "AlertCreate"
   },
   "AlertOut": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
     },
     "risk_score": {
      "type": "integer",
      "title": "Risk Score"
     },
     "risk_level": {
      "type": "string",
      "title": "Risk Level"
     },
     "categories": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Categories"
     },
     "note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     },
     "redacted_excerpt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Redacted Excerpt"
     },
     "acknowledged_at": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Acknowledged At"
