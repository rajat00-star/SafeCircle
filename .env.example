# Copy to backend/.env for local development. Never commit real values.
SAFECIRCLE_ENV=development
SAFECIRCLE_DATABASE_URL=sqlite:///./safecircle.db
# Production: a long random value, e.g. `openssl rand -hex 32`
SAFECIRCLE_SECRET_KEY=dev-only-insecure-secret-change-me
SAFECIRCLE_CORS_ORIGINS=http://localhost:3000
# Leave empty to build invite links from the request address
SAFECIRCLE_PUBLIC_BASE_URL=
SAFECIRCLE_STATIC_DIR=
SAFECIRCLE_RATE_LIMIT_PER_MINUTE=60
SAFECIRCLE_TRUST_PROXY_HEADERS=false
# Optional AI explanations (off unless both are set)
SAFECIRCLE_LLM_PROVIDER=none
SAFECIRCLE_ANTHROPIC_API_KEY=
