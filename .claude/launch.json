{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "safecircle",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && SAFECIRCLE_STATIC_DIR=../frontend/out exec .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "presentation",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--bind",
        "127.0.0.1",
        "--directory",
        "presentation/site"
      ],
      "port": 8090
    }
  ]
}
